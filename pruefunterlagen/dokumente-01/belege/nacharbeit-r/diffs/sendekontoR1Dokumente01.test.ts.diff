+
+  it('S10 Lauf ohne Wechsel: alles gesendet, Ergebnis gespeichert, Journal danach leer', async () => {
+    const sitzung = { konto: INHABER as string | null };
+    bereich(INHABER, 'full');
+    const ersatz = ersatzClient(sitzung);
+    const docs = ['doc-r1-n1', 'doc-r1-n2'].map((id) => dokument(id));
+    const outbox = docs.map((doc, index) => auftrag(`out-n${index}`, 'document', doc.id, herkunft(INHABER, 'full'), index + 1));
+    applyStateToStores(zustand({ documents: docs, syncOutbox: outbox }));
+    getSyncCoordinator().setAdapter(new SupabaseSyncAdapter(ersatz.client as never));
