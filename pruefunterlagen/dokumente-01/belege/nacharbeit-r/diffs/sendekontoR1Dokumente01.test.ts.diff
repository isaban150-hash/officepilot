+
+/* ------------------------------------------------------------------ */
+/* Bausteine                                                           */
+/* ------------------------------------------------------------------ */
+
+function bereich(userId: string, access: StorageAccess): void {
+  setActiveStorageScope({ type: 'workspace', workspaceId: WS, account: { userId, access } });
+}
+
+function kontoSchluessel(userId: string, access: StorageAccess): string {
+  return buildStorageKey({ type: 'workspace', workspaceId: WS, account: { userId, access } });
+}
+
+function herkunft(userId: string, access: StorageAccess): SyncOutboxOrigin {
+  return { userId, workspaceId: WS, access };
+}
+
+function dokument(id: string, extra: Partial<CompanyDocument> = {}): CompanyDocument {
+  return {
+    id,
+    title: `R1 synthetisch ${id}`,
+    category: 'sonstiges',
+    issuer: 'R1 Prüfung',
+    recognizedText: 'synthetisch',
+    issueDate: null,
+    validUntil: null,
+    digitalFolder: { id: 'sonstiges', name: 'Sonstiges', path: '/sonstiges' },
+    paperFolder: { folderId: 'sonstiges', register: 'S', label: 'Sonstiges' },
+    tags: [],
+    linkedCompany: null,
+    linkedVorgang: null,
+    archived: false,
+    createdAt: JETZT,
+    sync: { version: 0, updatedAt: JETZT, deleted: false, deviceId: 'geraet-r1', workspaceId: WS },
+    ...extra,
+  } as unknown as CompanyDocument;
+}
+
+function auftrag(
+  id: string,
+  entityType: SyncOutboxEntry['entityType'],
+  entityId: string,
+  origin?: SyncOutboxOrigin,
+  sequence?: number,
+): SyncOutboxEntry {
+  return {
+    id,
+    entityType,
+    entityId,
+    operation: 'create',
+    version: 0,
+    queuedAt: JETZT,
+    ...(sequence !== undefined ? { sequence } : {}),
+    retryCount: 0,
+    status: 'pending',
+    ...(origin ? { origin } : {}),
+  };
+}
+
+function zustand(teil: Partial<AppPersistedState>): AppPersistedState {
+  return {
+    version: STORAGE_VERSION,
+    invoiceEntries: [],
+    syncClient: { ...createSyncClient(), serverWorkspaceId: WS, workspaceId: WS },
+    syncOutbox: [],
+    setup: DEFAULT_SETUP,
+    vorgaenge: [],
+    customers: [],
+    inboxItems: [],
+    tasks: [],
+    documents: [],
+    savedAt: JETZT,
+    ...teil,
+  } as AppPersistedState;
+}
+
+interface Sendung {
+  konto: string | null;
+  art: string;
+  id: string | undefined;
+}
+
+/** Ersatzclient wie in der WEISS-Reproduktion: sendet sofort beim Aufruf und merkt sich die Sitzung dabei. */
+function ersatzClient(sitzung: { konto: string | null }) {
+  const sendungen: Sendung[] = [];
+  let tor: { erreicht: () => void; frei: Promise<void> } | null = null;
+  let nachSendung: ((name: string) => void) | null = null;
+  const client = {
+    auth: {
+      getSession: async () => ({
+        data: {
+          session: sitzung.konto ? { user: { id: sitzung.konto }, access_token: `zugang-${sitzung.konto}` } : null,
+        },
+      }),
+    },
+    rpc: async (name: string, args: Record<string, unknown>) => {
+      const payload = (args.p_payload ?? {}) as Record<string, unknown>;
+      sendungen.push({
+        konto: sitzung.konto,
+        art: String(args.p_entity_type ?? name),
+        id: (payload.client_document_id ?? payload.document_id) as string | undefined,
+      });
+      if (tor) {
+        const offen = tor;
+        tor = null;
+        offen.erreicht();
+        await offen.frei;
+      }
+      nachSendung?.(name);
+      if (name === 'pull_workspace_sync_state') return { data: {}, error: null };
+      if (name === 'pull_workspace_order_amendments') return { data: [], error: null };
+      return { data: { row_version: 1, deleted: false, payload: args.p_payload }, error: null };
+    },
+  };
+  return {
+    client,
+    sendungen,
+    /** Hält die nächste Sendung an, bis `frei()` gerufen wird. */
+    halteNaechste(): { erreicht: Promise<void>; frei: () => void } {
+      let erreicht!: () => void;
+      let frei!: () => void;
+      const erreichtP = new Promise<void>((resolve) => (erreicht = resolve));
+      const freiP = new Promise<void>((resolve) => (frei = resolve));
+      tor = { erreicht, frei: freiP };
+      return { erreicht: erreichtP, frei };
+    },
+    nachJederSendung(hook: (name: string) => void): void {
+      nachSendung = hook;
+    },
+  };
+}
+
+function journal(userId: string, access: StorageAccess): string[] {
+  return listConfirmedOutboxRecords(kontoSchluessel(userId, access)).map((record) => record.outboxId);
+}
+
+/* ------------------------------------------------------------------ */
+/* S1–S6: Kontowechsel während des Sendens (Ersatzclient)              */
+/* ------------------------------------------------------------------ */
+
+describe('DOKUMENTE-01 R1 — Kontowechsel während eines laufenden Sendens', () => {
