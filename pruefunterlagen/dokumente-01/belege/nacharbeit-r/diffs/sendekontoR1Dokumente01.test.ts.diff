+    await adapter.pushChanges({
+      deviceId: 'g',
+      workspaceId: WS,
+      state: zustand({ documents: [dokument('doc-mitglied-1')], syncOutbox: mitgliedOutbox }),
+      outbox: mitgliedOutbox,
+    });
+
+    // Zurück zum Inhaber: sein offener Auftrag geht unter ihm hinaus.
+    bereich(INHABER, 'full');
+    sitzung.konto = INHABER;
+    const offen = [{ ...ersterLauf[0], status: 'completed' as const }, auftrag('in-2', 'document', 'doc-inhaber-2', herkunft(INHABER, 'full'), 2)];
+    const letzter = await adapter.pushChanges({ deviceId: 'g', workspaceId: WS, state: zustand({ documents: inhaberDocs, syncOutbox: offen }), outbox: offen });
+
+    expect(ersatz.sendungen.map((sendung) => [sendung.konto, sendung.id])).toEqual([
