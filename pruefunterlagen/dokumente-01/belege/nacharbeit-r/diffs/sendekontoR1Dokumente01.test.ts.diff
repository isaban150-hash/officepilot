+    expect(koordinator.getStatus().syncState).toBe('idle');
+    expect(koordinator.getStatus().lastError).toBeUndefined();
+    // Bestätigt ist bestätigt: Der Inhaber sendet den Auftrag nie ein zweites Mal.
+    expect(journal(INHABER, 'full')).toEqual(['out-abruf']);
+  });
+
+  it('S9b Wechsel mitten im Abruf: kein weiterer Abruf, nichts übernommen', async () => {
+    const sitzung = { konto: INHABER as string | null };
+    bereich(INHABER, 'full');
+    const ersatz = ersatzClient(sitzung);
+    ersatz.nachJederSendung((name) => {
+      if (name === 'pull_workspace_sync_state') {
