+    const ergebnis = await koordinator.runSync(vorher);
+
+    expect(ersatz.sendungen.map((sendung) => sendung.art)).toEqual(['pull_workspace_sync_state']);
+    expect(ersatz.sendungen[0].konto).toBe(INHABER);
