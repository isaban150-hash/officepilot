+
+  it('S11 normaler Kontowechsel Inhaber → Mitglied → Inhaber: jeder sendet nur Eigenes mit eigenem Zugang', async () => {
+    const sitzung = { konto: INHABER as string | null };
+    const ersatz = ersatzClient(sitzung);
+    const adapter = new SupabaseSyncAdapter(ersatz.client as never);
+
+    // Inhaber: ein Auftrag geht hinaus, einer entsteht erst danach und bleibt beim Abmelden offen.
+    bereich(INHABER, 'full');
+    const inhaberDocs = [dokument('doc-inhaber-1'), dokument('doc-inhaber-2')];
+    const ersterLauf = [auftrag('in-1', 'document', 'doc-inhaber-1', herkunft(INHABER, 'full'), 1)];
+    await adapter.pushChanges({ deviceId: 'g', workspaceId: WS, state: zustand({ documents: inhaberDocs, syncOutbox: ersterLauf }), outbox: ersterLauf });
+
+    // Mitglied: nur seine eigenen Aufträge.
+    bereich(MITGLIED, 'member');
