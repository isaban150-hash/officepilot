+/* ------------------------------------------------------------------ */
+/* S7–S8: echtes Supabase-SDK, nur das Netz ersetzt                     */
+/* ------------------------------------------------------------------ */
+
+/** Feste, weit entfernte Ablaufzeit: Das synthetische Token ist je Konto immer dasselbe. */
+const ABLAUF = 4102444800;
+
+function synthetischesToken(konto: string): string {
+  const teil = (wert: object) => Buffer.from(JSON.stringify(wert)).toString('base64url');
+  return `${teil({ alg: 'HS256', typ: 'JWT' })}.${teil({ sub: konto, role: 'authenticated', exp: ABLAUF })}.synthetisch`;
+}
+
+function sitzungFuer(konto: string) {
+  return {
+    access_token: synthetischesToken(konto),
+    token_type: 'bearer',
+    expires_in: 3600,
+    expires_at: ABLAUF,
+    refresh_token: `synthetisch-erneuerung-${konto}`,
+    user: {
+      id: konto,
+      aud: 'authenticated',
+      role: 'authenticated',
+      app_metadata: {},
+      user_metadata: {},
+      created_at: '2026-10-20T00:00:00.000Z',
+    },
+  };
+}
+
+const SITZUNGSSCHLUESSEL = 'r1-sdk-sitzung';
+
+/** Realtime wird hier nie verbunden; die Testumgebung hat nur keinen WebSocket-Konstruktor. */
+class OhneVerbindung {
+  readonly readyState = 3;
+  close(): void {}
+  send(): void {}
+}
+
+interface NetzAnfrage {
+  pfad: string;
+  zugang: string | null;
+}
+
+function echterClient(ablage: Map<string, string>, beiAnfrage?: (pfad: string) => void) {
+  const anfragen: NetzAnfrage[] = [];
+  const netz = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    const pfad = new URL(String(input)).pathname;
+    anfragen.push({ pfad, zugang: new Headers(init?.headers).get('Authorization') });
+    beiAnfrage?.(pfad);
+    const body = pfad.startsWith('/storage/v1/object/')
+      ? { Key: 'workspace-files/r1', Id: 'r1' }
+      : { row_version: 1, deleted: false, payload: {} };
+    return new Response(JSON.stringify(body), { status: 200, headers: { 'Content-Type': 'application/json' } });
+  };
+  const client = createClient('http://127.0.0.1:54321', 'synthetischer-anon-schluessel', {
+    realtime: { transport: OhneVerbindung as never },
+    auth: {
+      storage: {
+        getItem: (key: string) => ablage.get(key) ?? null,
+        setItem: (key: string, value: string) => void ablage.set(key, value),
+        removeItem: (key: string) => void ablage.delete(key),
+      },
+      storageKey: SITZUNGSSCHLUESSEL,
+      persistSession: true,
+      autoRefreshToken: false,
+      detectSessionInUrl: false,
+    },
+    global: { fetch: netz as typeof fetch },
+  });
+  return { client, anfragen };
+}
+
+function melde(ablage: Map<string, string>, konto: string): void {
+  ablage.set(SITZUNGSSCHLUESSEL, JSON.stringify(sitzungFuer(konto)));
+}
+
+describe('DOKUMENTE-01 R1 — echtes SDK: Zugang aus der Prüfung, Halt vor jedem weiteren Schritt', () => {
+  it('S7 der Zugang stammt aus genau der Prüfung davor — auch wenn die Sitzung unmittelbar danach wechselt', async () => {
+    const ablage = new Map<string, string>();
+    melde(ablage, INHABER);
+    bereich(INHABER, 'full');
+    const { client, anfragen } = echterClient(ablage);
+
+    // Zweiter Tab: Unmittelbar nach dem nächsten Lesen der Sitzung meldet sich das Mitglied an.
+    const echtesLesen = client.auth.getSession.bind(client.auth);
+    let wechselNachLesen = false;
+    client.auth.getSession = (async () => {
+      const ergebnis = await echtesLesen();
+      if (wechselNachLesen) {
+        wechselNachLesen = false;
+        melde(ablage, MITGLIED);
+      }
+      return ergebnis;
+    }) as typeof client.auth.getSession;
+
+    const waechter = createSyncRunGuard(await captureSyncRunIdentity(client, WS), client);
+    const gebunden = bindClientToSyncRun(client, waechter);
+    const args = { p_workspace_id: WS, p_entity_type: 'archived_document', p_payload: {}, p_row_version: 0 };
+
+    wechselNachLesen = true;
+    const { error } = await gebunden.rpc('upsert_workspace_intake_entity', args);
+    expect(error).toBeNull();
+    expect(anfragen).toEqual([
+      { pfad: '/rest/v1/rpc/upsert_workspace_intake_entity', zugang: `Bearer ${synthetischesToken(INHABER)}` },
+    ]);
+
+    // Jetzt ist das Mitglied angemeldet: Die nächste Anfrage dieses Laufs entsteht gar nicht erst.
+    await expect(gebunden.rpc('upsert_workspace_intake_entity', args)).rejects.toMatchObject({
+      code: 'sync_run_identity_changed',
+    });
+    expect(anfragen).toHaveLength(1);
+    expect(waechter.tripped).toBe('sitzung');
+
+    // Gegenprobe ohne Bindung: Prüfen und Senden lesen die Sitzung getrennt — gesendet würde mit fremdem Zugang.
+    melde(ablage, INHABER);
+    wechselNachLesen = true;
