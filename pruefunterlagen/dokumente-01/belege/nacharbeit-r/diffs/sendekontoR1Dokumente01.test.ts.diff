+/**
+ * DOKUMENTE-01 R1 — ein Synchronisationslauf sendet nur unter dem Konto, dem er gehört.
+ *
+ * WEISS-Endrecheck vom 20.10.2026 (R1): Ein laufender Push schickte die restlichen
+ * Aufträge des ersten Kontos mit dem Zugang eines zweiten, das sich inzwischen (auch
+ * in einem zweiten Tab) angemeldet hatte.
+ *
+ *  S1  Inhaber → Mitglied während der ersten Sendung: genau eine Sendung, unter dem
+ *      Inhaber; der Rest bleibt unverändert offen; die Bestätigung steht im Journal des
+ *      Inhabers, nicht in dem des Mitglieds
+ *  S2  Gegenrichtung Mitglied → Inhaber
+ *  S3  Abmeldung während des Laufs
+ *  S4  nur die Sitzung wechselt (zweiter Tab), der Speicherbereich bleibt: ebenfalls Halt
+ *  S5  mehrstufiges Dokument: Archivzeile bestätigt, Wechsel vor der Originalbindung →
+ *      keine Bindung unter dem neuen Konto, der Auftrag bleibt offen und gilt nicht als erledigt
+ *  S6  kein doppelter Versand: der nächste Lauf des Ursprungskontos sendet nur den Rest;
+ *      nach einem Neustart wendet das Laden das Journal an und räumt es danach auf
+ *  S7  echtes SDK: Der Zugang einer Anfrage stammt aus genau der Prüfung davor, nicht aus
+ *      einer später gelesenen Sitzung (Gegenprobe ohne Bindung: dort trüge sie den fremden)
+ *  S8  echtes SDK, Datei: Bytes lesen → Hochladen → Registrieren. Wechsel während des
+ *      Lesens: nichts gesendet. Wechsel nach dem Hochladen: Upload unter dem Ursprungskonto,
+ *      keine Registrierung unter dem neuen
+ *  S9  Abruf: Wechsel zwischen Senden und Abruf oder mitten im Abruf → nichts übernommen,
+ *      kein weiterer Abruf, keine Fehlermeldung, kein Bericht mit fremden Aufträgen
+ *  S10 Lauf ohne Wechsel: alles gesendet, Ergebnis gespeichert, Journal danach leer
+ *  S11 normaler Kontowechsel Inhaber → Mitglied → Inhaber: jeder Lauf sendet nur eigene
+ *      Aufträge mit eigenem Zugang; Ungesendetes des Inhabers geht danach unter ihm hinaus
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createClient } from '@supabase/supabase-js';
+import { DEFAULT_SETUP } from '../../data/mockData';
+import type { AppPersistedState, CompanyDocument } from '../../types/models';
+import type { SyncOutboxEntry, SyncOutboxOrigin } from '../../types/sync';
+import type { DocumentFileRef } from '../../types/documentFileRef';
+import { STORAGE_VERSION } from './syncMigrationService';
+import { createSyncClient, resetSyncClientForTests } from './syncClientService';
+import { getSyncOutboxSnapshot, resetSyncOutboxForTests } from './syncOutboxService';
+import { SupabaseSyncAdapter } from './supabaseSyncAdapter';
+import { SyncCoordinator, SYNC_IDENTITY_CHANGED_REPORT_ID, getSyncCoordinator, resetSyncCoordinatorForTests } from './syncCoordinator';
+import { buildConfirmationJournalKey, listConfirmedOutboxRecords } from './syncConfirmationJournal';
+import { bindClientToSyncRun, captureSyncRunIdentity, createSyncRunGuard } from './syncRunIdentityService';
+import { pushPendingChangesFromUi } from './syncUiService';
+import {
+  buildStorageKey,
+  resetStorageScopeForTests,
+  setActiveStorageScope,
+  type StorageAccess,
+} from '../storage/storageScopeService';
+import { switchToWorkspaceScope } from '../storage/storageBootstrapService';
+import { applyStateToStores } from '../persistenceService';
+import * as supabaseLib from '../../lib/supabase';
+import * as dateiSpeicher from '../documentFileStoreService';
+import { resetDocumentFileStoreForTests, storeDocumentFileFromCachedPayload } from '../documentFileStoreService';
+import { useDocumentBlobDatabaseReset } from '../../test/documentBlobTestReset';
+
+const WS = 'ws-r1-dok01';
+const INHABER = 'konto-inhaber-r1';
+const MITGLIED = 'konto-mitglied-r1';
+const JETZT = '2026-10-20T12:00:00.000Z';
+
+useDocumentBlobDatabaseReset();
+
+beforeEach(() => {
+  localStorage.clear();
+  resetStorageScopeForTests();
+  resetSyncOutboxForTests([]);
+  resetSyncClientForTests({ ...createSyncClient(), serverWorkspaceId: WS, workspaceId: WS });
+  resetSyncCoordinatorForTests();
+  vi.spyOn(supabaseLib, 'isSupabaseConfigured').mockReturnValue(true);
