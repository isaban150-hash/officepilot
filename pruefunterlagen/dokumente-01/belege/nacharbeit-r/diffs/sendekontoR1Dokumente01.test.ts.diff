+    von: { konto: string; access: StorageAccess };
+    wechsel: (sitzung: { konto: string | null }) => void;
+    dokumente?: CompanyDocument[];
+  }) {
+    const sitzung = { konto: input.von.konto as string | null };
+    bereich(input.von.konto, input.von.access);
+    const ersatz = ersatzClient(sitzung);
+    const docs = input.dokumente ?? ['doc-r1-1', 'doc-r1-2', 'doc-r1-3'].map((id) => dokument(id));
+    const outbox = docs.map((doc, index) =>
+      auftrag(`out-${index}`, 'document', doc.id, herkunft(input.von.konto, input.von.access), index + 1),
+    );
+    const halt = ersatz.halteNaechste();
+    const lauf = new SupabaseSyncAdapter(ersatz.client as never).pushChanges({
+      deviceId: 'geraet-r1',
+      workspaceId: WS,
+      state: zustand({ documents: docs, syncOutbox: outbox }),
+      outbox,
+    });
+    await halt.erreicht;
+    input.wechsel(sitzung);
+    halt.frei();
+    return { ergebnis: await lauf, ersatz, outbox };
+  }
+
+  it('S1 Inhaber → Mitglied während der ersten Sendung: genau eine Sendung, unter dem Inhaber; der Rest bleibt offen', async () => {
+    const { ergebnis, ersatz, outbox } = await laufMitWechsel({
