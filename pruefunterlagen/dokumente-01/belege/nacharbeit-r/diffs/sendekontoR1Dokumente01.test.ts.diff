+  it('S6 kein doppelter Versand: der nächste Lauf des Inhabers sendet nur den Rest; ein Neustart wendet das Journal an', async () => {
+    const { outbox } = await laufMitWechsel({
+      von: { konto: INHABER, access: 'full' },
+      wechsel: (sitzung) => {
+        bereich(MITGLIED, 'member');
+        sitzung.konto = MITGLIED;
+      },
