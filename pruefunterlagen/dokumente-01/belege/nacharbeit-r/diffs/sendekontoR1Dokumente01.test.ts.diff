+    // Der Inhaber meldet sich wieder an; sein gespeicherter Bestand ist der von vor dem Lauf.
+    const docs = ['doc-r1-1', 'doc-r1-2', 'doc-r1-3'].map((id) => dokument(id));
+    const sitzung = { konto: INHABER as string | null };
+    bereich(INHABER, 'full');
+    const ersatz = ersatzClient(sitzung);
+    const zweiter = await new SupabaseSyncAdapter(ersatz.client as never).pushChanges({
+      deviceId: 'geraet-r1',
