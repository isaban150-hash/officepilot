+    expect(geprueft.data.session?.user.id).toBe(INHABER);
+    await client.rpc('upsert_workspace_intake_entity', args);
+    expect(anfragen[1].zugang).toBe(`Bearer ${synthetischesToken(MITGLIED)}`);
+  });
+
+  async function dateiAuftrag(): Promise<{ ref: DocumentFileRef; outbox: SyncOutboxEntry[]; state: AppPersistedState }> {
+    const bytes = new TextEncoder().encode('%PDF-1.4 R1 synthetischer Beleg');
+    const { fileRef } = await storeDocumentFileFromCachedPayload(
+      { fileName: 'r1-beleg.pdf', mimeType: 'application/pdf', fileSize: bytes.byteLength, bytes },
+      { lifecycleIntent: 'committed' },
+    );
+    const outbox = [auftrag('out-datei', 'document_file', fileRef.id, herkunft(INHABER, 'full'), 1)];
+    return { ref: fileRef, outbox, state: zustand({ documentFileRefs: [fileRef], syncOutbox: outbox } as Partial<AppPersistedState>) };
+  }
+
+  it('S8a Datei: Wechsel während des Lesens der Bytes → weder Upload noch Registrierung', async () => {
+    const ablage = new Map<string, string>();
+    melde(ablage, INHABER);
+    bereich(INHABER, 'full');
+    const { client, anfragen } = echterClient(ablage);
+    const { outbox, state } = await dateiAuftrag();
+
+    const echtesLesen = dateiSpeicher.getOriginalDocumentFileBytes;
+    vi.spyOn(dateiSpeicher, 'getOriginalDocumentFileBytes').mockImplementation(async (...args) => {
+      const bytes = await echtesLesen(...args);
+      melde(ablage, MITGLIED);
+      bereich(MITGLIED, 'member');
+      return bytes;
+    });
+
+    const ergebnis = await new SupabaseSyncAdapter(client).pushChanges({ deviceId: 'geraet-r1', workspaceId: WS, state, outbox });
+
+    expect(anfragen).toEqual([]);
+    expect(ergebnis.identityChanged).toBe(true);
+    expect(ergebnis.completedOutboxIds).toEqual([]);
+    expect(ergebnis.state.syncOutbox).toEqual(outbox);
+  });
+
+  it('S8b Datei: Wechsel nach dem Upload → Upload unter dem Inhaber, keine Registrierung unter dem Mitglied', async () => {
+    const ablage = new Map<string, string>();
+    melde(ablage, INHABER);
+    bereich(INHABER, 'full');
+    const { client, anfragen } = echterClient(ablage, (pfad) => {
+      if (pfad.startsWith('/storage/v1/object/')) {
+        melde(ablage, MITGLIED);
+        bereich(MITGLIED, 'member');
+      }
+    });
+    const { outbox, state } = await dateiAuftrag();
+
+    const ergebnis = await new SupabaseSyncAdapter(client).pushChanges({ deviceId: 'geraet-r1', workspaceId: WS, state, outbox });
+
+    expect(anfragen).toHaveLength(1);
+    expect(anfragen[0].pfad.startsWith('/storage/v1/object/')).toBe(true);
+    expect(anfragen[0].zugang).toBe(`Bearer ${synthetischesToken(INHABER)}`);
+    expect(ergebnis.identityChanged).toBe(true);
+    expect(ergebnis.completedOutboxIds).toEqual([]);
+    expect(ergebnis.state.syncOutbox).toEqual(outbox);
+    expect(journal(INHABER, 'full')).toEqual([]);
+  });
+
+  it('S12 eigener Token-Lieferant: Wechsel nur des Tokens (Bereich bleibt) → Halt; gesendet wird das geprüfte Token', async () => {
+    for (const art of ['jwt', 'undurchsichtig'] as const) {
+      bereich(INHABER, 'full');
+      const token = (konto: string) => (art === 'jwt' ? synthetischesToken(konto) : `synthetischer-zugang-${konto}`);
+      let angemeldet = INHABER;
+      const anfragen: NetzAnfrage[] = [];
+      let erreicht!: () => void;
+      let frei!: () => void;
+      const ersteErreicht = new Promise<void>((resolve) => (erreicht = resolve));
+      const freigabe = new Promise<void>((resolve) => (frei = resolve));
+      const client = createClient('http://127.0.0.1:54321', 'synthetischer-anon-schluessel', {
+        realtime: { transport: OhneVerbindung as never },
+        accessToken: async () => token(angemeldet),
+        global: {
+          fetch: (async (input: RequestInfo | URL, init?: RequestInit) => {
+            anfragen.push({ pfad: new URL(String(input)).pathname, zugang: new Headers(init?.headers).get('Authorization') });
+            if (anfragen.length === 1) {
+              erreicht();
+              await freigabe;
+            }
+            return new Response(JSON.stringify({ row_version: 1, deleted: false, payload: {} }), {
+              status: 200,
+              headers: { 'Content-Type': 'application/json' },
+            });
+          }) as typeof fetch,
+        },
+      });
+      const docs = [dokument(`doc-r1-lieferant-${art}-1`), dokument(`doc-r1-lieferant-${art}-2`)];
+      const outbox = docs.map((doc, index) => auftrag(`out-${art}-${index}`, 'document', doc.id, herkunft(INHABER, 'full'), index + 1));
+
+      const lauf = new SupabaseSyncAdapter(client).pushChanges({
+        deviceId: 'geraet-r1',
+        workspaceId: WS,
+        state: zustand({ documents: docs, syncOutbox: outbox }),
+        outbox,
+      });
+      await ersteErreicht;
+      // Nur das Token wechselt; der Speicherbereich bleibt der des Inhabers.
+      angemeldet = MITGLIED;
+      frei();
+      const ergebnis = await lauf;
+
+      expect(anfragen.map((anfrage) => anfrage.zugang), art).toEqual([`Bearer ${token(INHABER)}`]);
+      expect(ergebnis.identityChanged, art).toBe(true);
+      expect(ergebnis.identityChangeReason, art).toBe('sitzung');
+      expect(ergebnis.completedOutboxIds, art).toEqual([outbox[0].id]);
+    }
+  });
+
+  it('S8c Datei ohne Wechsel: Upload und Registrierung beide mit dem Zugang des Inhabers', async () => {
+    const ablage = new Map<string, string>();
+    melde(ablage, INHABER);
+    bereich(INHABER, 'full');
+    const { client, anfragen } = echterClient(ablage);
+    const { outbox, state } = await dateiAuftrag();
+
+    const ergebnis = await new SupabaseSyncAdapter(client).pushChanges({ deviceId: 'geraet-r1', workspaceId: WS, state, outbox });
+
+    expect(anfragen.map((anfrage) => anfrage.zugang)).toEqual([
+      `Bearer ${synthetischesToken(INHABER)}`,
+      `Bearer ${synthetischesToken(INHABER)}`,
+    ]);
+    expect(anfragen[1].pfad).toBe('/rest/v1/rpc/upsert_workspace_intake_entity');
+    expect(ergebnis.success).toBe(true);
+    expect(ergebnis.completedOutboxIds).toEqual(['out-datei']);
+  });
+});
