+/**
+ * Legt hashgleiche, bereits vorliegende Bytes unter einer Cloud-Referenz ab und
+ * prüft sie wie jeden Schreibvorgang; danach ist die Referenz lokal (wie nach
+ * `materializeCloudDocumentFile`). Persistiert nicht — das tun die Aufrufer.
+ */
+async function adoptVerifiedBytesForCloudFileRef(
+  ref: DocumentFileRef,
+  bytes: Uint8Array,
+  contentHash: string,
+): Promise<DocumentFileRef> {
+  let blob: Blob;
+  try {
+    blob = new Blob([bytes], { type: ref.mimeType || 'application/octet-stream' });
+  } catch {
+    throw new DocumentBlobStorageError('blob_write_failed');
+  }
+
+  try {
+    await saveDocumentBlob({
+      fileRefId: ref.id,
+      blob,
+      mimeType: ref.mimeType,
+      fileSize: ref.fileSize,
+      contentHash,
+      createdAt: ref.createdAt,
+    });
+  } catch (error) {
+    if (error instanceof DocumentBlobStorageError) {
+      throw error;
+    }
+    throw new DocumentBlobStorageError('blob_write_failed', error);
+  }
+
+  try {
+    await verifyStoredBlobMatchesExpected({
+      fileRefId: ref.id,
+      expectedHash: contentHash,
+      expectedByteLength: ref.fileSize,
+    });
+  } catch (error) {
+    try {
+      await deleteDocumentBlob(ref.id);
+    } catch {
+      /* best-effort rollback of the adopted blob */
+    }
+    if (error instanceof DocumentBlobStorageError) {
+      throw error;
+    }
+    throw new DocumentBlobStorageError('blob_hash_mismatch', error);
+  }
+
+  fileRefs = fileRefs.map((entry) =>
+    entry.id === ref.id ? { ...entry, storageType: 'indexeddb' as const, localDataKey: entry.localDataKey || entry.id } : entry,
+  );
+  return getDocumentFileRefById(ref.id) ?? ref;
+}
