+/* ------------------------------------------------------------------ */
+/* L1–L3: Kontowechsel während der Nachweisrückfrage                    */
+/* ------------------------------------------------------------------ */
+
+describe('DOKUMENTE-01 DOK-WEISS-DIREKT — Kontowechsel während der Rückfrage', () => {
+  it('L1 WEISS-Reproduktion (echtes SDK, keine Sitzung): kein Erfolg, B behält sein Dokument, kein Löschauftrag', async () => {
+    ausgangslage();
+    const { client } = echterClient(new Map());
+    let erreicht!: () => void;
+    let frei!: () => void;
+    const rueckfrageErreicht = new Promise<void>((resolve) => (erreicht = resolve));
+    const freigabe = new Promise<void>((resolve) => (frei = resolve));
+    const rueckfragen: string[] = [];
+    client.rpc = (async (name: string) => {
+      rueckfragen.push(name);
+      erreicht();
+      await freigabe;
+      return { data: false, error: null };
+    }) as never;
+
+    const loeschung = deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_INHABER, GEPRUEFT);
+    await rueckfrageErreicht;
+    // Wie WEISS: Bereich und Bestand von B während der angehaltenen Rückfrage.
+    setActiveStorageScope({ type: 'workspace', workspaceId: WS, account: { userId: MITGLIED, access: 'member' } });
+    hydrateDocumentStore([brief()]);
+    resetSyncOutboxForTests([]);
+    persistAll();
+    frei();
+    const ergebnis = await loeschung;
+
+    expect(ergebnis).toEqual({ ok: false, errorKey: DOCUMENT_DELETE_IDENTITY_CHANGED_KEY });
+    expect(rueckfragen).toEqual(['is_workspace_document_payment_proof']);
+    expect(aktiv(BRIEF)).toBe(true);
+    expect(auftraege(BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(MITGLIED, 'member', BRIEF)).toBe(true);
+    expect(gespeicherteAuftraege(MITGLIED, 'member', BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(INHABER, 'full', BRIEF)).toBe(true);
+    expect(gespeicherteAuftraege(INHABER, 'full', BRIEF)).toEqual([]);
+    // Gegenprobe wie bei WEISS: B selbst darf direkt nicht löschen.
+    await expect(deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_MITGLIED, GEPRUEFT)).resolves.toEqual({
+      ok: false,
+      errorKey: DOCUMENT_DELETE_FORBIDDEN_KEY,
+    });
+    expect(aktiv(BRIEF)).toBe(true);
+  });
+
+  it('L1b keine Sitzung beim Aufruf, B meldet sich während der Rückfrage im zweiten Tab an (Bereich bleibt): Abbruch', async () => {
+    ausgangslage();
+    const sitzung = { konto: null as string | null };
+    const ersatz = ersatzClient(sitzung);
+    const halt = ersatz.halte('is_workspace_document_payment_proof');
+
+    const loeschung = deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_INHABER, GEPRUEFT);
+    await halt.erreicht;
+    sitzung.konto = MITGLIED;
+    halt.frei();
+    const ergebnis = await loeschung;
+
+    expect(ergebnis).toEqual({ ok: false, errorKey: DOCUMENT_DELETE_IDENTITY_CHANGED_KEY });
+    expect(getActiveStorageKey()).toBe(kontoSchluessel(INHABER, 'full'));
+    expect(aktiv(BRIEF)).toBe(true);
+    expect(auftraege(BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(INHABER, 'full', BRIEF)).toBe(true);
+  });
+
+  it('L2 bestätigte Anmeldung A, echter Kontowechsel zu B während der Rückfrage: kein Erfolg, nichts bei B', async () => {
+    ausgangslage();
+    const sitzung = { konto: INHABER as string | null };
+    const ersatz = ersatzClient(sitzung);
+    const halt = ersatz.halte('is_workspace_document_payment_proof');
+
+    const loeschung = deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_INHABER, GEPRUEFT);
+    await halt.erreicht;
+    sitzung.konto = MITGLIED;
+    wechsleZu(MITGLIED, 'member');
+    halt.frei();
+    const ergebnis = await loeschung;
+
+    expect(ergebnis).toEqual({ ok: false, errorKey: DOCUMENT_DELETE_IDENTITY_CHANGED_KEY });
+    expect(ersatz.rueckfragen).toEqual([{ name: 'is_workspace_document_payment_proof', konto: INHABER, betrieb: WS }]);
+    expect(getActiveStorageKey()).toBe(kontoSchluessel(MITGLIED, 'member'));
+    expect(aktiv(BRIEF)).toBe(true);
+    expect(auftraege(BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(MITGLIED, 'member', BRIEF)).toBe(true);
+    expect(gespeicherteAuftraege(MITGLIED, 'member', BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(INHABER, 'full', BRIEF)).toBe(true);
+    expect(gespeicherteAuftraege(INHABER, 'full', BRIEF)).toEqual([]);
+  });
+
+  it('L3 nur die Sitzung wechselt (zweiter Tab), der Bereich bleibt: Abbruch, A behält das Dokument', async () => {
+    ausgangslage();
+    const sitzung = { konto: INHABER as string | null };
+    const ersatz = ersatzClient(sitzung);
+    const halt = ersatz.halte('is_workspace_document_payment_proof');
+
+    const loeschung = deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_INHABER, GEPRUEFT);
+    await halt.erreicht;
+    sitzung.konto = MITGLIED;
+    halt.frei();
+    const ergebnis = await loeschung;
+
+    expect(ergebnis).toEqual({ ok: false, errorKey: DOCUMENT_DELETE_IDENTITY_CHANGED_KEY });
+    expect(getActiveStorageKey()).toBe(kontoSchluessel(INHABER, 'full'));
+    expect(aktiv(BRIEF)).toBe(true);
+    expect(auftraege(BRIEF)).toEqual([]);
+    expect(gespeichertAktiv(INHABER, 'full', BRIEF)).toBe(true);
+  });
+});
+
+/* ------------------------------------------------------------------ */
+/* L4–L6: ohne Wechsel, Abmeldung, Rückkehr                              */
+/* ------------------------------------------------------------------ */
+
+describe('DOKUMENTE-01 DOK-WEISS-DIREKT — ohne Wechsel, Abmeldung und Rückkehr zum Ursprungskonto', () => {
+  it.each([
+    ['mit bestätigter Anmeldung', INHABER],
+    ['ohne bestätigte Anmeldung (nur lokal im eigenen Bereich)', null],
+  ] as const)('L4 A ohne Wechsel, %s: gelöscht, Löschauftrag mit Herkunft A', async (_fall, konto) => {
+    ausgangslage();
+    const ersatz = ersatzClient({ konto });
+
+    const ergebnis = await deleteGeneratedInvoiceDocumentWithCloud(BRIEF, ALS_INHABER, GEPRUEFT);
