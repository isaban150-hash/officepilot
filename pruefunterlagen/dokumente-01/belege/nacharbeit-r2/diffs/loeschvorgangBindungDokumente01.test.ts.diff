+
+/** Legt den gespeicherten Bestand eines Kontos an (Betrieb, Dokumente, leere Warteschlange). */
+function bestandAnlegen(userId: string, access: StorageAccess, docs: CompanyDocument[], vorgaenge: Vorgang[] = []): void {
+  setActiveStorageScope({ type: 'workspace', workspaceId: WS, account: { userId, access } });
+  betrieb();
+  hydrateVorgangStore(vorgaenge);
+  hydrateDocumentStore(docs);
+  resetSyncOutboxForTests([]);
+  persistAll();
+}
+
+/** Zwei Konten desselben Betriebs mit je eigenem Bestand; aktiv ist der Inhaber. */
+function ausgangslage(docs: () => CompanyDocument[] = () => [brief()], vorgaenge: () => Vorgang[] = () => []): void {
+  bestandAnlegen(MITGLIED, 'member', docs(), vorgaenge());
+  bestandAnlegen(INHABER, 'full', docs(), vorgaenge());
+  for (const doc of docs()) {
+    expect(gespeicherteAuftraege(INHABER, 'full', doc.id)).toEqual([]);
+    expect(gespeicherteAuftraege(MITGLIED, 'member', doc.id)).toEqual([]);
+  }
+}
+
+function gespeichert(userId: string, access: StorageAccess): AppPersistedState | null {
+  const raw = localStorage.getItem(kontoSchluessel(userId, access));
+  return raw ? (JSON.parse(raw) as AppPersistedState) : null;
+}
+
+function gespeichertAktiv(userId: string, access: StorageAccess, id: string): boolean {
+  const doc = gespeichert(userId, access)?.documents.find((d) => d.id === id);
+  return Boolean(doc) && !doc!.sync?.deleted;
+}
+
+function gespeicherteAuftraege(userId: string, access: StorageAccess, id: string): SyncOutboxEntry[] {
+  return (gespeichert(userId, access)?.syncOutbox ?? []).filter((entry) => entry.entityId === id);
+}
+
+function aktiv(id: string): boolean {
+  const doc = getDocumentStoreSnapshot().find((d) => d.id === id);
+  return Boolean(doc) && !doc!.sync?.deleted;
+}
+
+function auftraege(id: string): SyncOutboxEntry[] {
+  return getSyncOutboxSnapshot().filter((entry) => entry.entityId === id);
+}
+
+interface Rueckfrage {
+  name: string;
+  konto: string | null;
+  betrieb: unknown;
+}
+
+/** Ersatzclient: Sitzung zum Ablesen, jede Rückfrage mit dem Konto, das gerade angemeldet ist. */
+function ersatzClient(sitzung: { konto: string | null }, antwort: (name: string) => unknown = () => false) {
+  const rueckfragen: Rueckfrage[] = [];
+  let tor: { name: string; erreicht: () => void; frei: Promise<void> } | null = null;
+  const client = {
+    auth: {
+      getSession: async () => ({
+        data: { session: sitzung.konto ? { user: { id: sitzung.konto }, access_token: `zugang-${sitzung.konto}` } : null },
+      }),
+    },
+    rpc: async (name: string, args: Record<string, unknown>) => {
+      rueckfragen.push({ name, konto: sitzung.konto, betrieb: args.p_workspace_id });
+      if (tor?.name === name) {
+        const offen = tor;
+        tor = null;
+        offen.erreicht();
+        await offen.frei;
+      }
+      return { data: antwort(name), error: null };
+    },
+  };
+  vi.spyOn(supabaseLib, 'getSupabaseClient').mockReturnValue(client as never);
+  return {
+    rueckfragen,
+    /** Hält die nächste Rückfrage `name` an, bis `frei()` gerufen wird. */
+    halte(name: string): { erreicht: Promise<void>; frei: () => void } {
+      let erreicht!: () => void;
+      let frei!: () => void;
+      const erreichtP = new Promise<void>((resolve) => (erreicht = resolve));
+      const freiP = new Promise<void>((resolve) => (frei = resolve));
+      tor = { name, erreicht, frei: freiP };
+      return { erreicht: erreichtP, frei };
+    },
+  };
+}
+
+/** Feste, weit entfernte Ablaufzeit: Das synthetische Token ist je Konto immer dasselbe. */
+const ABLAUF = 4102444800;
+
+function synthetischesToken(konto: string): string {
+  const teil = (wert: object) => Buffer.from(JSON.stringify(wert)).toString('base64url');
+  return `${teil({ alg: 'HS256', typ: 'JWT' })}.${teil({ sub: konto, role: 'authenticated', exp: ABLAUF })}.synthetisch`;
+}
+
+const SITZUNGSSCHLUESSEL = 'loeschbindung-sdk-sitzung';
+
+class OhneVerbindung {
+  readonly readyState = 3;
+  close(): void {}
+  send(): void {}
+}
+
+interface NetzAnfrage {
+  pfad: string;
+  zugang: string | null;
+  betrieb: unknown;
+}
+
+/** Echtes Supabase-SDK; ersetzt sind nur die Sitzungsablage und das Netz. */
+function echterClient(ablage: Map<string, string>, antwort: (pfad: string) => unknown = () => false) {
+  const anfragen: NetzAnfrage[] = [];
+  const netz = async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    const pfad = new URL(String(input)).pathname;
+    const body = typeof init?.body === 'string' ? (JSON.parse(init.body) as Record<string, unknown>) : {};
+    anfragen.push({ pfad, zugang: new Headers(init?.headers).get('Authorization'), betrieb: body.p_workspace_id });
+    return new Response(JSON.stringify(antwort(pfad)), { status: 200, headers: { 'Content-Type': 'application/json' } });
+  };
+  const client = createClient('http://127.0.0.1:54321', 'synthetischer-anon-schluessel', {
+    realtime: { transport: OhneVerbindung as never },
+    auth: {
+      storage: {
+        getItem: (key: string) => ablage.get(key) ?? null,
+        setItem: (key: string, value: string) => void ablage.set(key, value),
+        removeItem: (key: string) => void ablage.delete(key),
+      },
+      storageKey: SITZUNGSSCHLUESSEL,
+      persistSession: true,
+      autoRefreshToken: false,
+      detectSessionInUrl: false,
+    },
+    global: { fetch: netz as typeof fetch },
+  });
+  vi.spyOn(supabaseLib, 'getSupabaseClient').mockReturnValue(client);
+  return { client, anfragen };
+}
+
+function melde(ablage: Map<string, string>, konto: string): void {
+  ablage.set(
+    SITZUNGSSCHLUESSEL,
+    JSON.stringify({
+      access_token: synthetischesToken(konto),
+      token_type: 'bearer',
+      expires_in: 3600,
+      expires_at: ABLAUF,
+      refresh_token: `synthetisch-erneuerung-${konto}`,
+      user: { id: konto, aud: 'authenticated', role: 'authenticated', app_metadata: {}, user_metadata: {}, created_at: JETZT },
+    }),
+  );
+}
+
+/** Der echte Kontowechsel der App: Bestand des Zielkontos laden. */
+function wechsleZu(userId: string, access: StorageAccess): void {
+  switchToWorkspaceScope(userId, WS, access, INHABER);
+}
