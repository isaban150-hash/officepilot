+  | { type: 'workspace'; workspaceId: string; account?: StorageAccount | null };
 
 let activeScope: StorageScope = { type: 'guest' };
 
+/** Das Konto, für das ein Betriebsschlüssel gebildet wird — explizit, das aktive oder keines (Altbestand). */
+export function resolveWorkspaceAccount(
+  scope: Extract<StorageScope, { type: 'workspace' }>,
+): StorageAccount | undefined {
+  if (scope.account === null) return undefined;
+  if (scope.account) return scope.account;
+  if (activeScope.type === 'workspace' && activeScope.workspaceId === scope.workspaceId) {
+    return activeScope.account ?? undefined;
+  }
+  return undefined;
+}
