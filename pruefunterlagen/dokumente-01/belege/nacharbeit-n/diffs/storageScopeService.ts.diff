+export const NAVIGATION_STATE_SCOPE_KEY = 'officetaktStorageScope' as const;
+
+export function stampNavigationStateWithActiveScope<T extends object>(
+  state: T,
+): T & { readonly [NAVIGATION_STATE_SCOPE_KEY]: string } {
+  return { ...state, [NAVIGATION_STATE_SCOPE_KEY]: getActiveStorageKey() };
+}
+
+export function isNavigationStateFromActiveScope(state: unknown): boolean {
+  if (!state || typeof state !== 'object') return false;
+  return (state as Record<string, unknown>)[NAVIGATION_STATE_SCOPE_KEY] === getActiveStorageKey();
+}
