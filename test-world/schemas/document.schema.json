{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officepilot.local/test-world/schemas/document.schema.json",
  "title": "TestWorld Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "companyId", "documentType", "subtype", "taxonomyTypeId", "title", "receivedAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{5}$",
      "description": "Stable document id, e.g. DOC-00001 (five digits)"
    },
    "companyId": {
      "type": "string",
      "pattern": "^COMPANY-[0-9]{3}$"
    },
    "projectId": {
      "description": "null for firm-level documents",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^PRJ-[0-9]{3}$" }
      ]
    },
    "customerId": {
      "type": "string",
      "pattern": "^CUST-[0-9]{3}$"
    },
    "supplierId": {
      "type": "string",
      "pattern": "^SUP-[0-9]{3}$",
      "description": "Counterparty id (suppliers/ folder)"
    },
    "employeeId": {
      "type": "string",
      "pattern": "^EMP-[0-9]{3}$"
    },
    "vehicleId": {
      "type": "string",
      "pattern": "^VEH-[0-9]{3}$"
    },
    "taxonomyTypeId": {
      "type": "string",
      "pattern": "^DOCTYPE-[0-9]{3}$",
      "description": "Frozen leaf type from taxonomy/document-taxonomy.json"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "inquiry",
        "offer",
        "order_confirmation",
        "contract",
        "amendment",
        "delivery_note",
        "incoming_invoice",
        "outgoing_invoice",
        "credit_note",
        "fuel_receipt",
        "hotel_invoice",
        "authority_letter",
        "insurance_letter",
        "bank_letter",
        "advisor_letter",
        "legal_letter",
        "utility",
        "telecom",
        "vehicle_document",
        "hr",
        "payment_reminder",
        "dunning",
        "acceptance",
        "inspection_protocol",
        "site_diary",
        "photo",
        "marketing",
        "spam",
        "other"
      ]
    },
    "subtype": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Frozen subtype key; must match taxonomy leaf with documentType"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "receivedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "lifecyclePhase": {
      "type": "string",
      "enum": [
        "inquiry",
        "offer",
        "contract",
        "execution",
        "billing",
        "warranty",
        "archive",
        "firm"
      ]
    },
    "qualityTag": {
      "type": "string",
      "enum": [
        "clean",
        "skew",
        "dark",
        "blur",
        "cropped",
        "dirty",
        "stamp_over_amount",
        "handwriting",
        "crease",
        "missing_page",
        "rotated_page",
        "two_docs_one_image",
        "duplicate_exact",
        "duplicate_near",
        "broken_pdf",
        "low_contrast",
        "glare",
        "partial_ocr"
      ],
      "default": "clean"
    },
    "sourceKind": {
      "type": "string",
      "enum": ["pdf", "photo", "scan", "none"],
      "default": "none"
    },
    "sourceFile": {
      "type": "string",
      "description": "Relative path under documents/DOC-***/ when present"
    },
    "ocrTextFile": { "type": "string" },
    "suiteTags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["smoke", "commit", "release", "nightly", "monthly", "matching", "summary", "mobile"]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "description": "Presentation expectations for later tests — not domain writes",
      "properties": {
        "classifiedKind": { "type": "string" },
        "caseMatchStatus": {
          "type": "string",
          "enum": ["exact", "likely", "multiple", "none"]
        },
        "matchedProjectId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^PRJ-[0-9]{3}$" }
          ]
        },
        "primaryActionId": { "type": "string" },
        "alertIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
