{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://officepilot.local/test-world/schemas/employee.schema.json",
  "title": "TestWorld Employee",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "companyId", "firstName", "lastName", "role"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EMP-[0-9]{3}$",
      "description": "Stable employee id, e.g. EMP-001"
    },
    "companyId": {
      "type": "string",
      "pattern": "^COMPANY-[0-9]{3}$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^BRANCH-[0-9]{3}$"
    },
    "firstName": {
      "type": "string",
      "minLength": 1
    },
    "lastName": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "office",
        "foreman",
        "technician",
        "apprentice",
        "driver",
        "other"
      ]
    },
    "email": { "type": "string" },
    "phone": { "type": "string" },
    "active": {
      "type": "boolean",
      "default": true
    },
    "defaultVehicleId": {
      "type": "string",
      "pattern": "^VEH-[0-9]{3}$"
    },
    "notes": { "type": "string" }
  }
}
