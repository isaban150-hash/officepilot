# Supabase Auth (öffentlicher Anon-Key – kein Service-Role-Key committen)
# Projekt-URL ohne Pfad, z. B. https://xxxxx.supabase.co (NICHT …/rest/v1/)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Beta-Tester-Modus: Setup überspringen, Musterbetrieb, Auto-Login als Admin
# NUR für lokale/staging Beta-Tests. In Production NIEMALS auf true setzen.
# VITE_BETA_TEST_MODE=true

# Ersteinrichtung: Standard-Admin lokal anlegen (admin@officepilot.local)
# In Production nur temporär für die erste Admin-Einrichtung aktivieren, danach entfernen.
# VITE_ALLOW_DEFAULT_ADMIN=true

# ---------------------------------------------------------------------------
# SERVER-SECRETS – Supabase Edge Function "ai"
# ---------------------------------------------------------------------------
# ACHTUNG: Diese Werte gehören NICHT in diese Datei und NICHT in Vercel.
# Sie werden ausschliesslich als Edge-Function-Secrets gesetzt:
#
#   npx supabase secrets set GEMINI_API_KEY=...
#
# Kein VITE_-Präfix: Alles mit VITE_ wird von Vite in das ausgelieferte
# Browser-Bundle kompiliert und ist damit für jeden Nutzer lesbar.
# Der frühere VITE_GEMINI_API_KEY war genau deshalb ein Sicherheitsproblem.
#
# GEMINI_API_KEY                          (Pflicht)
# AI_RATE_LIMIT_SHORT_WINDOW_SECONDS      (optional, Standard 60)
# AI_RATE_LIMIT_SHORT                     (optional, Standard 20)
# AI_RATE_LIMIT_DAILY                     (optional, Standard 500)
#
# SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase der Function
# automatisch bereit – nicht selbst setzen.

# Node/Vitest (nicht im Browser-Bundle)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# E-MAIL-VERSAND (Rechnung / Korrekturbeleg) – EMAIL-01B / V1-B1
# ---------------------------------------------------------------------------
# Serverseitig, ausschliesslich als Secrets der Edge Function "send-document":
#
#   npx supabase secrets set MAIL_PROVIDER=stub
#   npx supabase secrets set MAIL_PROVIDER=brevo BREVO_API_KEY=<…> MAIL_SENDER_EMAIL=<…>
#
# MAIL_PROVIDER  (Pflicht) – erlaubt sind genau "stub" oder "brevo"; jeder
#                andere oder fehlende Wert ist fail-closed: die Function
#                antwortet mit server_misconfigured, es wird nichts gesendet.
#                stub  = kein Netz, kein Provider; Ergebnis nach Empfaenger-
#                        domain (nur .invalid-Domains: bounce.invalid,
#                        provider.invalid, timeout.invalid, auth.invalid).
#                        Fuer lokale Entwicklung und E2E.
#                brevo = echter Versand ueber die Brevo-API (Staging/Prod).
# BREVO_API_KEY  (Pflicht bei MAIL_PROVIDER=brevo) – NUR serverseitig.
#                NIEMALS mit VITE_-Praefix, niemals in .env.local/Vercel:
#                alles mit VITE_ landet lesbar im Browser-Bundle.
#
# Client (Build-Zeit, Vite):
# VITE_MAIL_PROVIDER – Provider-Absicht des Clients. Nur der Wert "stub"
#                schaltet den Client auf stub; JEDER andere oder fehlende
#                Wert bedeutet "brevo" (impliziter Default). Der Server
#                vergleicht mit MAIL_PROVIDER und lehnt Abweichungen mit
#                provider_mismatch ab. Lokal/E2E daher VITE_MAIL_PROVIDER=stub
#                setzen; Staging/Prod: weglassen oder "brevo".
# VITE_MAIL_PROVIDER=stub
#
# MAIL_SENDER_EMAIL (Pflicht) – technische Absenderadresse (Header-From) des
#                Versands, NUR serverseitig als Function-Secret. Die Domain
#                muss beim Mailprovider authentifiziert sein (Brevo: Domain-
#                Authentifizierung mit DKIM/DMARC), sonst scheitert jeder Versand.
#                Kein Default, kein Fallback: fehlend oder ungueltig -> die
#                Function antwortet server_misconfigured und ruft keinen
#                Provider. Der Wert wird nie geloggt.
#                Beispiel: rechnung@send.officetakt.de
#
#   npx supabase secrets set MAIL_SENDER_EMAIL=rechnung@send.officetakt.de
#
# Anzeigename und Reply-To kommen nicht aus dieser Variable: Rechnung/Korrektur
# aus dem eingefrorenen Firmen-Snapshot der Rechnung, normale Dokumente aus dem
# aktuellen Firmenprofil (Kommunikations-Einstellungen: Absender-Anzeigename,
# Antwortadresse).

# ---------------------------------------------------------------------------
# STAGING-KENNZEICHNUNG – V1-B1
# ---------------------------------------------------------------------------
# Nur fuer das getrennte Staging-System setzen. Zeigt oberhalb der App ein
# unuebersehbares Banner "STAGING – Testumgebung". Jeder andere oder fehlende
# Wert zeigt nichts (Produktion und lokale Entwicklung bleiben unmarkiert).
# VITE_APP_ENVIRONMENT=staging
