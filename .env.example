# Gemini (Google AI) – optional für KI-Funktionen
# Niemals echte Keys committen. Werte nur in Vercel / .env.local setzen.

# Browser/Vite (wird ins Frontend gebündelt)
VITE_GEMINI_API_KEY=

# Supabase Auth (öffentlicher Anon-Key – kein Service-Role-Key committen)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Modell überschreiben (Standard: gemini-2.5-flash)
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Beta-Tester-Modus: Setup überspringen, Musterbetrieb, Auto-Login als Admin
# NUR für lokale/staging Beta-Tests. In Production NIEMALS auf true setzen.
# VITE_BETA_TEST_MODE=true

# Ersteinrichtung: Standard-Admin lokal anlegen (admin@officepilot.local)
# In Production nur temporär für die erste Admin-Einrichtung aktivieren, danach entfernen.
# VITE_ALLOW_DEFAULT_ADMIN=true

# Node/Vitest (nicht im Browser-Bundle)
GEMINI_API_KEY=
