# Gemini (Google AI) – gleicher Schlüssel wie Hilfe24
# Niemals echte Keys committen. Kopieren nach .env.local und Werte eintragen.

# Browser/Vite (wird ins Frontend gebündelt – nur für lokale Entwicklung verwenden)
VITE_GEMINI_API_KEY=

# Optional: Modell überschreiben (Standard: gemini-2.5-flash)
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Node/Vitest (nicht im Browser-Bundle)
GEMINI_API_KEY=
